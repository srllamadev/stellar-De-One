{
  "name": "remesas-latam",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "engines": {"node": ">=22.14.0 <23", "npm": ">=10 <12"},
  "scripts": {
    "dev:web": "npm run dev --workspace @remesas/web",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "lint:web": "npm run lint --workspace @remesas/web",
    "typecheck:web": "npm run typecheck --workspace @remesas/web",
    "build:web": "npm run build --workspace @remesas/web",
    "lint:api": "uv run --directory apps/api ruff check .",
    "test:api": "uv run --directory apps/api pytest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:migrate": "uv run --directory apps/api alembic upgrade head",
    "verify": "npm run lint:web && npm run typecheck:web && npm run lint:api && npm run test:api && npm run build:web",
    "smoke": "node scripts/smoke.mjs",
    "setup": "node scripts/setup.mjs",
    "tree": "node scripts/tree.mjs"
  }
}
